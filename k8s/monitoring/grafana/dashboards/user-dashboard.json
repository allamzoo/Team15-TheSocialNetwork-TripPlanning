{
  "uid": "user-service",
  "title": "User Service Dashboard",
  "description": "S1-INFRA OWNED — replace panels in feature/m3-s1-infra-user PR",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "tags": ["user-service", "m3", "s1"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"user-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}",
          "refId": "A"
        }
      ],
      "description": "Requests per second per endpoint — shows which user-service endpoints are under the most load."
    },
    {
      "id": 2,
      "title": "HTTP Latency Percentiles (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "description": "P50/P95/P99 latency — high P99 on /trip-summary or /top-travelers signals slow Feign calls."
    },
    {
      "id": 3,
      "title": "JVM Heap Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"user-service\", area=\"heap\"}",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"user-service\", area=\"heap\"}",
          "legendFormat": "Heap Max",
          "refId": "B"
        }
      ],
      "description": "JVM heap used vs max — alerts on memory pressure before OOM."
    },
    {
      "id": 4,
      "title": "HikariCP DB Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"user-service\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections{job=\"user-service\"}",
          "legendFormat": "Total Pool Size",
          "refId": "B"
        }
      ],
      "description": "HikariCP active connections vs pool size — detects pool exhaustion during high load."
    },
    {
      "id": 5,
      "type": "logs",
      "title": "All Log Lines",
      "description": "LogQL — all log lines from user-service. Use for volume inspection and general tracing.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "{app=\"user-service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "wrapLogMessage": true,
        "showTime": true
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "WARN and ERROR Logs",
      "description": "LogQL — WARN and ERROR level log lines from user-service. First stop for incident triage.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "{app=\"user-service\", level=~\"WARN|ERROR\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "wrapLogMessage": true,
        "showTime": true
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Feign Outbound Call Logs",
      "description": "LogQL — log lines containing 'Feign' showing outbound calls to itinerary-service and booking-service.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "{app=\"user-service\"} |= \"Feign\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "wrapLogMessage": true,
        "showTime": true
      }
    }
  ]
}