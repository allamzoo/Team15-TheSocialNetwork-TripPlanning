{
  "uid": "destination-service",
  "title": "Destination Service Dashboard",
  "description": "S2-INFRA OWNED — replace panels in feature/m3-s2-infra-destination PR",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{service=\"destination-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency P99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{service=\"destination-service\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Used (MB)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{service=\"destination-service\", area=\"heap\"} / 1048576",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 4,
      "title": "Log Volume by Level",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (level) (rate({app=\"destination-service\", namespace=\"tripplanning\"}[5m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"destination-service\", namespace=\"tripplanning\"} |= \"ERROR\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "Feign Call Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"destination-service\", namespace=\"tripplanning\"} |= \"FeignClient\"",
          "legendFormat": ""
        }
      ]
    }
  ]
}