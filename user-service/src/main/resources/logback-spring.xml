
<configuration scan="true" scanPeriod="30 seconds">
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="user-service"/>
    <!--  ─── Console appender ────────────────────────────────────────────────  -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!--  ─── Loki4J appender — K8s only ─────────────────────────────────────  -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push</url>
            <batchMaxItems>1000</batchMaxItems>
            <batchTimeoutMs>5000</batchTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>app=${APP_NAME},service=${APP_NAME},level=%level,logger=%logger{20}</pattern>
            </label>
            <message>
                <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%level","logger":"%logger","thread":"%thread","correlationId":"%X{correlationId:-}","userId":"%X{userId:-}","message":"%message","exception":"%ex{short}"}</pattern>
                <omitEmptyFields>true</omitEmptyFields>
            </message>
        </format>
    </appender>
    <!--  Async wrapper — log calls must not block request threads  -->
    <appender name="ASYNC_LOKI" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <neverBlock>true</neverBlock>
    </appender>
    <!--  ─── Suppress noisy framework loggers ────────────────────────────────  -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
    <!--  Feign wire logging: DEBUG only in dev  -->
    <springProfile name="local,dev">
        <logger name="feign" level="DEBUG"/>
        <logger name="com.team15.tripplanning.userservice" level="DEBUG"/>
    </springProfile>
    <!--  ─── Application logger ──────────────────────────────────────────────  -->
    <logger name="com.team15.tripplanning.userservice" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_LOKI"/>
    </logger>
    <!--  ─── Root ────────────────────────────────────────────────────────────  -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_LOKI"/>
    </root>
</configuration>