                "});",
                "var recs = pm.response.json();",
                "pm.test('[a] Response is an array', function() {",
                "  pm.expect(recs).to.be.an('array');",
                "});",
                "pm.test('[a] Exactly 2 recommendations (D3 and D4)', function() {",
                "  pm.expect(recs.length).to.eql(2);",
                "});",
                "var ids = recs.map(function(r) { return r.destinationId; });",
                "var d3Id = parseInt(pm.environment.get('d3Id'));",
                "var d4Id = parseInt(pm.environment.get('d4Id'));",
                "var d1Id = parseInt(pm.environment.get('d1Id'));",
                "var d2Id = parseInt(pm.environment.get('d2Id'));",
                "pm.test('[a] D3 (Tokyo) is recommended', function() {",
                "  pm.expect(ids).to.include(d3Id);",
                "});",
                "pm.test('[a] D4 (Rome) is recommended', function() {",
                "  pm.expect(ids).to.include(d4Id);",
                "});",
                "pm.test('[a] D1 (Beach) NOT in recommendations', function() {",
                "  pm.expect(ids).to.not.include(d1Id);",
                "});",
                "pm.test('[a] D2 (Mountain) NOT in recommendations', function() {",
                "  pm.expect(ids).to.not.include(d2Id);",
                "});",
                "pm.test('[a] Each rec has destinationId, name, country, category, score', function() {",
