    {
      "name": "TEST 1 \u2014 200 Dashboard (spec: totalItineraries=5, completedItineraries=3, totalVisitors=3, avg=4.9)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{destinationBaseUrl}}/api/destinations/{{destId}}/dashboard",
          "host": [
            "{{destinationBaseUrl}}"
          ],
          "path": [
            "api",
            "destinations",
            "{{destId}}",
            "dashboard"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "console.log('Dashboard response:', JSON.stringify(body));",
              "pm.test('totalItineraries = 5 (3 PAID + 1 PLANNED + 1 CANCELLED)', function () {",
              "  pm.expect(body.totalItineraries).to.eql(5);",
              "});",
              "pm.test('completedItineraries = 3 (3 PAID \u2014 STATUS_COMPLETED_FAMILY)', function () {",
              "  pm.expect(body.completedItineraries).to.eql(3);",
              "});",
              "pm.test('totalVisitors = 3 (distinct userId across PAID itineraries)', function () {",
              "  pm.expect(body.totalVisitors).to.eql(3);",
              "});",
              "pm.test('totalRatings = 2 (from local Destination row)', function () {",
              "  pm.expect(body.totalRatings).to.eql(2);",
              "});",
              "pm.test('averageRating = 4.9 (from local Destination row)', function () {",
              "  pm.expect(body.averageRating).to.eql(4.9);",
              "});",
              "pm.test('completionRate present', function () {",
              "  pm.expect(body).to.have.property('completionRate');",
              "});",
              "console.log('VERIFY: DASHBOARD_VIEWED document logged in MongoDB destination_events');"
            ]
          }
        }
      ]
    },
