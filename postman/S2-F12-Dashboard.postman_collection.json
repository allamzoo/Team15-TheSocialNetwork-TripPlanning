            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Luxor\",\n  \"country\": \"Egypt\",\n  \"category\": \"HISTORICAL\",\n  \"status\": \"ACTIVE\",\n  \"rating\": 4.9,\n  \"totalRatings\": 2,\n  \"description\": \"A beautiful destination\"\n}"
        },
        "url": {
          "raw": "{{destinationBaseUrl}}/api/destinations",
          "host": [
            "{{destinationBaseUrl}}"
          ],
          "path": [
            "api",
            "destinations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Destination created', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "pm.environment.set('destId', pm.response.json().id);",
              "console.log('destId (spec: ID=5):', pm.response.json().id);"
            ]
          }
        }
      ]
