    {
      "name": "TEST \u2014 Revenue Happy Path (expect totalBookings=5, totalRevenue=2000, avg=400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{destinationBaseUrl}}/api/destinations/{{destId}}/revenue?startDate=2026-03-01&endDate=2026-03-31",
          "host": [
            "{{destinationBaseUrl}}"
          ],
          "path": [
            "api",
            "destinations",
            "{{destId}}",
            "revenue"
          ],
          "query": [
            {
              "key": "startDate",
              "value": "2026-03-01"
            },
            {
              "key": "endDate",
              "value": "2026-03-31"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('destinationId matches', function () {",
              "  pm.expect(String(body.destinationId)).to.eql(String(pm.environment.get('destId')));",
              "});",
              "pm.test('name is Dahab', function () {",
              "  pm.expect(body.name).to.eql('Dahab');",
              "});",
              "pm.test('totalBookings present (spec expects 5 with seed data)', function () {",
              "  pm.expect(body).to.have.property('totalBookings');",
              "  console.log('totalBookings:', body.totalBookings, '(spec expects 5 after booking seed)');",
              "});",
              "pm.test('totalRevenue present (spec expects 2000.00)', function () {",
              "  pm.expect(body).to.have.property('totalRevenue');",
              "  console.log('totalRevenue:', body.totalRevenue, '(spec expects 2000.00)');",
              "});",
              "pm.test('averageBookingAmount present (spec expects 400.00)', function () {",
              "  pm.expect(body).to.have.property('averageBookingAmount');",
              "  console.log('averageBookingAmount:', body.averageBookingAmount, '(spec expects 400.00)');",
              "});"
            ]
          }
        }
      ]
    },
