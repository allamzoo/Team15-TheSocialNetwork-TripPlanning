{
  "info": {
    "_postman_id": "s2-f3-revenue-v2",
    "name": "S2-F3 Destination Booking Revenue",
    "description": "Spec scenario: Destination ID=1 (Dahab). 3 itineraries in itinerary-postgres referencing destinationId=1. 5 CONFIRMED bookings with amounts 200,300,400,500,600 in March 2026. Expect totalBookings=5, totalRevenue=2000.00, averageBookingAmount=400.00.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SETUP 1 \u2014 Create Destination (Dahab, ADVENTURE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dahab\",\n  \"country\": \"Egypt\",\n  \"category\": \"ADVENTURE\",\n  \"status\": \"ACTIVE\",\n  \"rating\": 0.0,\n  \"totalRatings\": 0,\n  \"description\": \"A beautiful destination\"\n}"
        },
        "url": {
          "raw": "{{destinationBaseUrl}}/api/destinations",
          "host": [
            "{{destinationBaseUrl}}"
          ],
          "path": [
            "api",
            "destinations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Destination created (200 or 201)', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "pm.environment.set('destId', pm.response.json().id);",
              "console.log('destId saved:', pm.response.json().id);"
            ]
          }
        }
      ]
    },
