    {
      "name": "TEST 5 \u2014 200 Admin Verifies Review (spec: verifiedBy=ADMIN \u2192 verified=true + metadata)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verifiedBy\": {{adminUserId}}\n}"
        },
        "url": {
          "raw": "{{destinationBaseUrl}}/api/destinations/{{destId}}/reviews/{{reviewId}}/verify",
          "host": [
            "{{destinationBaseUrl}}"
          ],
          "path": [
            "api",
            "destinations",
            "{{destId}}",
            "reviews",
            "{{reviewId}}",
            "verify"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 \u2014 ADMIN verify accepted (spec step 1)', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var body = pm.response.json();",
              "// Find the review in the returned destination",
              "var reviews = body.destinationReviews;",
              "if (reviews && reviews.length > 0) {",
              "  var verified = reviews.find(function(r) {",
              "    return String(r.id) === String(pm.environment.get('reviewId'));",
              "  });",
              "  if (verified) {",
              "    pm.test('review.verified is true (spec expect)', function () {",
              "      pm.expect(verified.verified).to.eql(true);",
              "    });",
              "    pm.test('metadata contains verifiedAt (spec expect)', function () {",
              "      pm.expect(verified.metadata).to.have.property('verifiedAt');",
              "    });",
              "    pm.test('metadata.verifiedBy equals adminUserId (spec expect)', function () {",
              "      pm.expect(String(verified.metadata.verifiedBy)).to.eql(String(pm.environment.get('adminUserId')));",
              "    });",
              "  } else {",
              "    console.warn('Review not found in response body \u2014 check response structure');",
              "  }",
              "}"
            ]
          }
        }
      ]
    }
