{
  "info": {
    "_postman_id": "s2-f8-verify-v2",
    "name": "S2-F8 Verify Destination Review",
    "description": "Spec: Destination ID=1, Review ID=5 (visitDate=2026-01-15, verified=false). User ID=3 role=ADMIN. verifiedBy:3 \u2192 200. verifiedBy:1 (TRAVELER) \u2192 403. verifiedBy:999 (non-existent) \u2192 403. Future visitDate \u2192 400. Wrong destination \u2192 400.",
