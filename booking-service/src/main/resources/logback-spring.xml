<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ─── Console appender (human-readable for local dev) ─────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Loki4J appender — only active in k8s profile ───────────────────── -->
    <springProfile name="k8s">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${LOKI_URL:-http://loki.monitoring.svc.cluster.local:3100}/loki/api/v1/push</url>
            </http>
            <format>
                <label>
                    <pattern>app=booking-service,host=${HOSTNAME:-localhost},level=%level</pattern>
                </label>
                <message>
                    <pattern>
                        {
                          "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}",
                          "level": "%level",
                          "thread": "%thread",
                          "logger": "%logger{36}",
                          "message": "%message",
                          "correlationId": "%X{correlationId:-}",
                          "service": "booking-service"
                        }
                    </pattern>
                </message>
                <sortByTime>true</sortByTime>
            </format>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <!-- ─── Root logger (local / Docker Compose — console only) ─────────────── -->
    <springProfile name="!k8s">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ─── Reduce noise from framework internals ────────────────────────────── -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="com.netflix.discovery" level="WARN"/>

</configuration>
